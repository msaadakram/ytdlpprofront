# yt-dlp frontend configuration
NEXT_PUBLIC_API_URL=https://ytback-production.up.railway.app
API_BASE_URL=https://ytback-production.up.railway.app

# Google OAuth — Client ID for Google Identity Services (frontend)
# Create at https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client IDs -> Web application
# Add Authorized JavaScript origins: https://www.downforge.me, https://downforge.me, http://localhost:3000
# Site URL for sitemap/robots/canonicals
# NEXT_PUBLIC_SITE_URL=https://www.downforge.me
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
